{
	admin localhost:2019
	auto_https off
}

# Internal endpoints (e.g. the AI gateway for the agent-runner) are reachable only on the
# internal network, at http://cms-api:3100/_cms/internal/...; every public host answers 404.
(internal) {
	# An inline path matcher, so it sorts before the shorter `handle /_cms/*` below.
	handle /_cms/internal* {
		respond "Not found" 404
	}
}

# Every site host forwards /_cms/* to the CMS backend on the same origin (TECHNICAL §10.1).
# X-CMS-Env is set here and never trusted from the client.
(cms) {
	import internal
	handle /_cms/* {
		reverse_proxy cms-api:3100 {
			header_up X-CMS-Env {args[0]}
		}
	}
}

http://www.localhost {
	import cms prod
	handle {
		reverse_proxy site-prod:3000
	}
}

http://staging.localhost {
	import cms staging
	handle {
		reverse_proxy site-staging:3000
	}
}

# Changeset previews (E10.9): the previews service routes by host name.
http://*.localhost {
	@preview header_regexp host Host ^cs-[a-z0-9-]+\.localhost$
	handle @preview {
		import cms staging
		handle {
			reverse_proxy previews:8080
		}
	}
	handle {
		respond "Not found" 404
	}
}

http://mail.localhost {
	import internal
	reverse_proxy mailpit:8025
}

http://s3.localhost {
	import internal
	reverse_proxy s3:8333
}
