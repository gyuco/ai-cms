{
  "name": "@ai-cms/cms-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build && pnpm build:cli",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "build:cli": "esbuild cli/admin.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/admin.mjs --external:@node-rs/argon2 --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@ai-cms/audit": "workspace:*",
    "@ai-cms/auth": "workspace:*",
    "@ai-cms/db": "workspace:*",
    "@ai-cms/widget": "workspace:*",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2"
  }
}
